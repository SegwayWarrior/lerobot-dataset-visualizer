  <gazebo reference="Left_bio_gripper_right_finger">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_mimic_joint_plugin.so" name="Left_bio_gripper_left_finger_jointmimic_joint_plugin">
      <joint>Left_right_finger_joint</joint>
      <mimicJoint>Left_left_finger_joint</mimicJoint>
      <!-- if set to true, PID parameters from "/gazebo_ros_control/pid_gains/${mimic_joint}" are loaded -->
      <hasPID/>
      <multiplier>-1.0</multiplier>
      <offset>0</offset>
      <sensitiveness>0.0</sensitiveness>
      <!-- if absolute difference between setpoint and process value is below this threshold, do nothing; 0.0 = disable [rad] -->
      <maxEffort>10.0</maxEffort>
    </plugin>
  </gazebo>
  <!-- Insert at the end of xarm_device_macro.xacro -->
  <!-- Bracket link -->
  <link name="Left_d405_bracket">
    <visual>
      <origin rpy="-1.57079632679 0 1.57079632679" xyz="0.095 -0.051 0.0055"/>
      <geometry>
        <mesh filename="meshes/lite6_q2r2/meshes/d405_bracket_25deg.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Left_Silver"/>
    </visual>
    <!-- <collision>
      <origin xyz="0 -0.044 0.0055" rpy="-1.57079632679 0 1.57079632679"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision> -->
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <!-- Joint: Left_link_eef → bracket
       xyz/rpy are placeholders — adjust after viewing in RViz.
       The bracket attaches at the flange face; +Z is away from the flange. -->
  <joint name="Left_d405_bracket_joint" type="fixed">
    <parent link="Left_link_eef"/>
    <child link="Left_d405_bracket"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="Left_camera_joint" type="fixed">
    <origin rpy="3.1415926535897931 -1.1344640137963142 0" xyz="0.0615 0 -0.1085"/>
    <parent link="Left_d405_bracket"/>
    <child link="Left_camera_bottom_screw_frame"/>
  </joint>
  <link name="Left_camera_bottom_screw_frame"/>
  <joint name="Left_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.01085 0.009 0.021"/>
    <parent link="Left_camera_bottom_screw_frame"/>
    <child link="Left_camera_link"/>
  </joint>
  <link name="Left_camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0038 -0.009 0"/>
      <geometry>
        <mesh filename="meshes/realsense2_description/meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0078 -0.009 0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="camera_top_joint" type="fixed">
    <origin rpy="0.07 0.65 -1.5" xyz="0.3043 0.8485 0.5755"/>
    <parent link="world"/>
    <child link="camera_top_bottom_screw_frame"/>
  </joint>
  <link name="camera_top_bottom_screw_frame"/>
  <joint name="camera_top_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="camera_top_bottom_screw_frame"/>
    <child link="camera_top_link"/>
  </joint>
  <link name="camera_top_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="meshes/realsense2_description/meshes/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
